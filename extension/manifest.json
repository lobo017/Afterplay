{
  "manifest_version": 3,
  "name": "Wizard's Chess capture",
  "short_name": "WC capture",
  "description": "Captures your Lichess and Chess.com games for the offline Wizard's Chess analysis site.",
  "version": "0.0.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wizard's Chess capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://www.chess.com/*",
    "https://api.chess.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "lichess.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
